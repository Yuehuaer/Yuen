
{
  // 🆔 [订阅ID] 这是整个配置文件的身份证号
  // 必须唯一！如果别的脚本也叫这个名字，会冲突。建议加上你的名字前缀。
  "id": "yuehuaer_script",

  // 🏷️ [订阅名称] BoxJS 列表里显示的大标题
  "name": "Yuehuaer 专属脚本",

  // 🔑 [数据仓库] 这里列出所有需要被保存的变量名（Key）
  // ⚠️ 注意：这里的列表必须和下面 settings 里的 "id" 一一对应
  // BoxJS 会根据这个列表来持久化存储数据
  "keys": [
    "yuehuaer_switch",  // 对应下面的开关
    "yuehuaer_input",   // 对应下面的用户名输入框
    "yuehuaer_token"    // 对应下面的 Token 输入框
  ],

  // 🎨 [界面设置] 这里定义了在手机上长什么样
  "settings": [
    
    // ----------- 第 1 个组件：开关 -----------
    {
      "id": "yuehuaer_switch",      // 必须和 keys 里的名字一样
      "name": "功能开关",            // 界面上显示的标题
      "val": false,                 // 默认值：false (关闭) / true (开启)
      "type": "boolean",            // 组件类型：boolean 会渲染成一个开关按钮
      "desc": "开启后将执行核心任务"   // 标题下方的小字说明
    },

    // ----------- 第 2 个组件：文本输入 -----------
    {
      "id": "yuehuaer_input",       // 数据存储的 Key
      "name": "用户名",              // 标题
      "val": "",                    // 默认值：空字符串
      "type": "text",               // 组件类型：text 会渲染成一个输入框
      "placeholder": "请输入你的名字" // 提示语：当输入框为空时显示的灰色文字
    },

    // ----------- 第 3 个组件：敏感数据输入 -----------
    {
      "id": "yuehuaer_token",       // 数据存储的 Key
      "name": "API Token",          // 标题
      "val": "",                    // 默认值
      "type": "text",               // 也是输入框
      "desc": "敏感数据，请勿随意分享" // 重要的提示信息
    }
  ]
}
