#!name=Sliverkiss 精选挂机合集
#!desc=提取自 Sliverkiss 库的 5 个精选日常签到脚本（极核、顺丰、蜜雪、阿里云盘、夸克）
#!author=Yuehuaer
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/teaMilk.png

[Script]
# === 1. 极核 ZEEHO ===
# 获取 Cookie (包含正则匹配和抓包重写)
http-response ^https:\/\/tapi\.zeehoev\.com\/v1\.0\/mine\/cfmotoservermine\/setting script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/zeeho/zeeho.js, requires-body=true, timeout=60, tag=极核_获取Cookie
# 定时执行任务
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/zeeho/zeeho.js, tag=极核_日常签到

# === 2. 顺丰速运 ===
cron "30 8 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/1fb1cf9cd7486d30752b1ba29b871e37/raw/sfsy.js, tag=顺丰_日常签到

# === 3. 蜜雪冰城 ===
cron "22 8 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/865c82e42a5730bb696f6700ebb94cee/raw/mxbc.js, tag=蜜雪冰城_日常签到

# === 4. 阿里云盘 ===
cron "0 7,11 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/33800a98dcd029ba09f8b6fc6f0f5162/raw/aliyun.js, tag=阿里云盘_日常签到

# === 5. 夸克网盘 ===
cron "10 0 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/1589f69e675019b0b685a57a89de9ea5/raw/quarkV2.js, tag=夸克网盘_日常签到


[MITM]
# 抓取这些域名的流量（极核是真实的，后面几个我写了通配符用于占位展示）
hostname = tapi.zeehoev.com, *.sf-express.com, *.mxbc.com, *.aliyundrive.com, *.quark.cn