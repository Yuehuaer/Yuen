#!name=慕夏去广告
#!desc=自用屏蔽广告
#!author=慕夏
#!version=v1.0
#!date=2025-08-25
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlack.png
#!raw-url=https://raw.githubusercontent.com/Yuehuaer/Yuen/refs/heads/main/Plugin/Muxia-Adblock.plugin

# ---------------------------------------------------------------------------------------------------------------------------------------------------------------------
# 📌 Loon 的 REJECT 动作含义

# REJECT
# 直接阻断请求，不返回任何内容。
# 用于彻底丢弃请求。
# 有些 App/网页会因为拿不到返回值而报错或者卡住。

# REJECT-200
# 返回一个 HTTP 200 OK 空白响应。
# 应用/网页会以为请求成功了，但其实啥也没拿到。
# 常用来屏蔽网页广告、追踪接口，因为能让前端正常运行，不会卡住。

# REJECT-DROP
# 类似防火墙的丢弃，直接断开连接。
# 更「干净」，但有时会导致前端超时。

# REJECT-TINYGIF
# 返回一个极小的 1×1 像素透明 GIF 图片。
# 常用在拦截广告图片时，让前端以为图片加载成功。

# REJECT-TINYPNG（Loon 新版本支持）
# 返回一个极小的透明 PNG 图片。
# 和上面 GIF 原理一样。

# REJECT-TEXT
# 返回一个空文本。
# ---------------------------------------------------------------------------------------------------------------------------------------------------------------------

# > 东方财富
# hostname = emdcadvertise.eastmoney.com
^https?:\/\/emdcadvertise\.eastmoney\.com\/infoService\/v\d reject

# 东方航空
# hostname = app.ceair.com
^https?:\/\/app\.ceair\.com\/customize\/security\/update reject-200
^https?:\/\/app\.ceair\.com\/customize\/main\/adScreen reject-dict

# > 懂球帝
# hostname = ap.dongdianqiu.com
#^https?:\/\/ap\.dongqiudi\.com\/plat\/v reject
^https?:\/\/ap\.dongdianqiu\.com\/plat\/v4 reject
# > 动画疯
# hostname = api.gamer.com.tw
^https?:\/\/api\.gamer\.com\.tw\/mobile_app\/anime\/v\d\/anime_get_question\.php reject-dict

# > 滴滴出行
# hostname = res.xiaojukeji.com, common.diditaxi.com.cn, hd.xiaojukeji.com, freight.xiaojukeji.com, daijia.kuaidadi.com, ct.xiaojukeji.com, conf.diditaxi.com.cn
^https?:\/\/hd\.xiaojukeji\.com\/d reject-dict

# > 滴滴青桔
# hostname = pt-starimg.didistatic.com, omgup*.xiaojukeji.com
^https?:\/\/pt-starimg\.didistatic\.com\/static\/starimg\/node\/.*.(jpg|png|gif) reject-200
^https?:\/\/omgup[0-9]{1}\.xiaojukeji\.com\/api reject-200

# > 滴滴代驾小程序
# hostname = daijia.kuaidadi.com, as.xiaojukeji.com

# 横幅广告
^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/conf\?ns=daijia-front&name= reject-dict
^https?:\/\/daijia\.kuaidadi\.com\/gateway\?api=prado\.cms\.delivery\.batch&apiVe reject-dict
